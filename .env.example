# Copy to .env and fill in only what you use. Every key is optional:
# ThinkLess runs fully offline with local models when none are set.

# Hosted decision model (TypeSafe Jev) for the SystemOne provider.
TYPESAFE_API_KEY=

# Hosted reasoning models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Runtime settings.
THINKLESS_TRACE_DIR=.thinkless/traces
THINKLESS_DEVICE=auto
THINKLESS_CAPTURE_CONTENT=true
THINKLESS_LOG_LEVEL=WARNING
