  "knowledge_base": [
    {"id": "kb-shipping", "title": "Shipping times and options", "keywords": ["shipping", "delivery", "express", "standard", "how long", "ship", "days", "arrive"], "body": "Standard shipping takes 3 to 5 business days. Express shipping takes 1 to 2 business days and costs $12. Orders placed before 2 pm Eastern ship the same day."},
    {"id": "kb-returns", "title": "Returning an item", "keywords": ["return", "returns", "exchange", "unused", "label", "send back"], "body": "Unused items can be returned within 30 days of delivery. Start a return from the Orders page to get a free return label. Refunds for returned items are issued 5 to 7 business days after the item reaches our warehouse."},
    {"id": "kb-password", "title": "Resetting your password", "keywords": ["password", "reset", "forgot", "sign in", "login", "log in"], "body": "Choose Forgot password on the sign-in page and we will email you a reset link. The link is valid for 30 minutes."},
    {"id": "kb-plus", "title": "Plus membership", "keywords": ["plus", "membership", "member", "subscription", "price", "cost", "benefits", "annual", "monthly"], "body": "Plus costs $9.99 per month or $99 per year. Members get free express shipping and 10 percent off every order. You can cancel any time from Account, Membership."},
    {"id": "kb-giftcards", "title": "Gift cards", "keywords": ["gift card", "gift cards", "voucher", "expire", "balance"], "body": "Cobalt Market gift cards never expire and cannot be exchanged for cash. You can combine up to three gift cards on one order."},
    {"id": "kb-international", "title": "International shipping", "keywords": ["international", "abroad", "canada", "uk", "europe", "customs", "duties", "country", "countries"], "body": "We ship to 40 countries, including Canada, the United Kingdom and most of the European Union. International orders arrive in 7 to 14 business days. Customs duties are paid by the recipient on delivery."},
    {"id": "kb-address", "title": "Changing a shipping address", "keywords": ["address", "change address", "wrong address", "edit", "update address", "shipping address"], "body": "You can change the shipping address until the order ships. Open the order on the Orders page and choose Edit address. Once an order has shipped, the address can no longer be changed."},
    {"id": "kb-warranty", "title": "Product warranty", "keywords": ["warranty", "guarantee", "broken", "defective", "stopped working", "electronics"], "body": "Electronics come with a one year limited warranty from the delivery date. To make a claim, contact support with your order number and a photo or short video of the problem."}
  ]
